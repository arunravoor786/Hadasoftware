# Copy this file to .env.deploy (git-ignored) and fill it in.
# Hostinger: hPanel → Files → FTP Accounts shows the host, username and folder.
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21
# Folder that serves hadasoft.in, relative to the FTP account's home.
FTP_REMOTE_DIR=public_html
# Explicit TLS. Set to false only if your host does not support FTPS.
FTP_SECURE=true
