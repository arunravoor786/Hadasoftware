# Hadasoft website: Apache / LiteSpeed rules for Hostinger.
# Every route is a real prerendered file (e.g. /products/index.html), so no SPA
# catch-all is needed. Unknown paths get the proper 404 page.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Old page URLs from the previous site -> new routes (301 keeps search ranking).
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteRule ^products\.html$ /products/ [R=301,L,NC]
  RewriteRule ^bizwhats\.html$ /bizwhats/ [R=301,L,NC]
  RewriteRule ^acip\.html$ /acip/ [R=301,L,NC]
  RewriteRule ^about\.html$ /company/ [R=301,L,NC]
  RewriteRule ^contact\.html$ /contact/ [R=301,L,NC]
  RewriteRule ^about/?$ /company/ [R=301,L,NC]

  # The old stylesheet and script are no longer used.
  RewriteRule ^assets/(style\.css|site\.js)$ - [G,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # HTML is always revalidated so a new deploy shows up immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>
