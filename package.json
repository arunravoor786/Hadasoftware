{
  "name": "hadasoft-website",
  "private": true,
  "version": "1.0.0",
  "description": "Hadasoft company website: React, MUI and Motion, built as a static site for Hostinger.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "check:contact": "node scripts/check-contact.mjs",
    "og": "node scripts/render-og.mjs",
    "brand": "node scripts/render-brand.mjs",
    "shots": "node scripts/screenshots.mjs",
    "package": "node scripts/package-zip.mjs",
    "deploy": "node scripts/deploy-ftp.mjs",
    "deploy:dry": "node scripts/deploy-ftp.mjs --dry-run"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@mui/material": "^9.5.0",
    "lenis": "^1.3.27",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "basic-ftp": "^6.2.6",
    "fflate": "^0.8.3",
    "fontkit": "^2.0.4",
    "oxlint": "^1.92.0",
    "playwright-core": "^1.65.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wawoff2": "^2.0.1"
  }
}
